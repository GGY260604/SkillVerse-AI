# -----------------------------------------------------------------------------
# SkillVerse AI - FastAPI Microservice Configuration (.env.example)
# Copy this file to `.env` inside `src/fastapi/` and populate your secrets.
# -----------------------------------------------------------------------------

# Server Configuration
PORT=8000
DEBUG=true

# AI & Embedding Model Configuration
# Set to 'true' to run BAAI/bge-m3 locally on GPU/CPU with 0 Gemini tokens
ENABLE_LOCAL_BGE_M3=true

# Local LLM Engine (Primary tier before Gemini API fallback)
# Works out of the box with Ollama (http://localhost:11434/v1) or RunPod vLLM
ENABLE_LOCAL_LLM=true
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_API_KEY=ollama

# Local PII Redaction via GLiNER (Zero-shot PII stripping on-premise)
ENABLE_LOCAL_GLINER=true
GLINER_MODEL_NAME=urchade/gliner_multi-v2.1

# Optional: RunPod Remote Endpoint (if this FastAPI calls another RunPod worker)
RUNPOD_API_ENDPOINT=

# Supabase REST & Vector Engine Configuration
# Note: Use your project URL without /rest/v1 suffix (e.g. https://<ref>.supabase.co)
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-secret-key...
SUPABASE_ANON_KEY=eyJh...your-anon-public-key...

# Google Gemini API Key Pool (Cycles through available keys to avoid rate limits)
# Set ENABLE_GEMINI_API=false to test 100% offline local extraction without calling Gemini
ENABLE_GEMINI_API=true
# You can provide a single GEMINI_API_KEY or numbered pool GEMINI_API_KEY_1...N
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
