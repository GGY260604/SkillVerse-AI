datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ==========================================
// 1. User & Profile Management
// ==========================================

model User {
  id                    String        @id @default(uuid()) @db.Uuid
  email                 String        @unique
  name                  String?
  locale                String        @default("en") // 'en' | 'ms' | 'zh'
  
  // Progression & Leveling System
  exp                   Int           @default(0)
  level                 Int           @default(1)
  
  // ==========================================
  // Profile Information
  // ==========================================

  employmentStatus      String        @default("employed_at_risk") // employed_at_risk, fresh_grad_student, career_switcher, jobseeker
  currentJobTitle       String?
  industry              String?
  educationLevel        String?
  yearsOfExperience     String?
  
  skills                Json          @default("[]") // Stores user skill structure array (UserSkillItem[])
  toolsAndSoftware      String[]      @default([]) // List of common tools and software
  casualDescription     String?       // User's free-form description of daily work tasks
  languages             String[]      @default([]) // Languages spoken/written
  
  careerGoal            String?       @default("explore") // upskill, reskill, explore
  targetSectors         String[]      @default([]) // Target future sectors
  targetJobTitle        String?
  workArrangement       String?       @default("any") // remote, hybrid, onsite, any
  
  weeklyCommitmentHours String        @default("3-5") // 1-3, 3-5, 5-10, 10+
  learningProviders     String[]      @default(["free_open", "hrd_corp"]) // free_open, hrd_corp, industry_cert
  outputLanguage        String        @default("en")

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  roadmaps              Roadmap[]
  sharedRoadmaps        SharedRoadmap[] @relation("SharedRoadmapOwner")
  receivedRoadmaps      SharedRoadmap[] @relation("SharedRoadmapTarget")

  @@map("users")
}

// ==========================================
// 2. ESCO Taxonomy & Trend Signals
// ==========================================

model EscoRole {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId              String                       @unique @map("role_id")
  title               String
  titleMs             String                       @map("title_ms")
  titleZh             String                       @map("title_zh")
  industry            String
  requiredSkills          String[]                     @map("required_skills")
  requiredSkillsMs        String[]                     @default([]) @map("required_skills_ms")
  requiredSkillsZh        String[]                     @default([]) @map("required_skills_zh")
  requiredSkillsLocalized Json?                        @default("{}") @map("required_skills_localized") // { en: string[], ms: string[], zh: string[] }
  sdgAlignments       Json                         @default("[]") @map("sdg_alignments")
  scenarioMultipliers Json                         @default("{\"moderate\": 1.0, \"accelerated_ai\": 1.0, \"green_economy\": 1.0}") @map("scenario_multipliers")
  radarRequirements   Json                         @default("{}") @map("radar_requirements")
  embedding           Unsupported("vector(1024)")? // bge-m3 1024-dimensional vector
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @default(now()) @updatedAt @map("updated_at")

  @@map("esco_roles")
}

model SdgTarget {
  id          String                       @id @default(uuid()) @db.Uuid
  targetCode  String                       @unique @map("target_code") // e.g. "SDG 8.2", "SDG 9.4"
  goalNumber  Int                          @map("goal_number")        // 1 to 17
  title       String
  description String
  embedding   Unsupported("vector(1024)")?
  createdAt   DateTime                     @default(now()) @map("created_at")

  @@map("sdg_targets")
}

model TrendSignal {
  id             String   @id @default(uuid()) @db.Uuid
  skillName      String   @unique
  category       String
  currentWindowC Float    @default(0.0) // Current window frequency Ct
  pastWindowC    Float    @default(0.0) // Historical window frequency Ct-1
  velocityVs     Float    @default(0.0) // Signal velocity Vs
  status         String   // emerging, stable, declining
  sources        Json     // Ingestion sources and timestamps [{sourceName, url, timestamp}]
  updatedAt      DateTime @updatedAt

  @@map("trend_signals")
}

// ==========================================
// 3. Roadmap & Planning Engine
// ==========================================

model Roadmap {
  id                   String           @id @default(uuid()) @db.Uuid
  sessionId            String?          @map("session_id") // Anonymous session tracking
  userId               String?          @db.Uuid @map("user_id")
  user                 User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status               String           @default("current") // 'current' | 'history'
  
  targetRoleId         String           @map("target_role_id")
  targetRoleTitle      String           @map("target_role_title")
  targetTitleLocalized Json?            @map("target_title_localized") // { en: string, ms: string, zh: string }
  roleCategory         String?          @map("role_category")
  description          String?
  descriptionLocalized Json?            @map("description_localized") // { en: string, ms: string, zh: string }
  scenario             String           @default("moderate") // moderate, accelerated_ai, green_economy
  
  matchScore           Float            @default(0.0) @map("match_score")
  matchScoreBasis      String?          @map("match_score_basis")
  
  sdgs                 String[]         @default([]) // e.g. ["SDG 8.2", "SDG 9.4"]
  matchedStrengths          String[]         @default([]) @map("matched_strengths")
  matchedStrengthsMs        String[]         @default([]) @map("matched_strengths_ms")
  matchedStrengthsZh        String[]         @default([]) @map("matched_strengths_zh")
  matchedStrengthsLocalized Json?            @map("matched_strengths_localized") // { en: string[], ms: string[], zh: string[] }
  skillsGap                 String[]         @default([]) @map("skills_gap")
  skillsGapMs               String[]         @default([]) @map("skills_gap_ms")
  skillsGapZh               String[]         @default([]) @map("skills_gap_zh")
  skillsGapLocalized        Json?            @map("skills_gap_localized") // { en: string[], ms: string[], zh: string[] }
  atRiskSkills              String[]         @default([]) @map("at_risk_skills")
  atRiskSkillsMs            String[]         @default([]) @map("at_risk_skills_ms")
  atRiskSkillsZh            String[]         @default([]) @map("at_risk_skills_zh")
  atRiskSkillsLocalized     Json?            @map("at_risk_skills_localized") // { en: string[], ms: string[], zh: string[] }
  
  totalWeeks           Int              @default(10) @map("total_weeks")
  totalHours           Int              @default(45) @map("total_hours")
  
  radarData            Json             @default("[]") @map("radar_data") // Multi-dimensional radar chart comparison data
  topRoles             Json             @default("[]") @map("top_roles") // Ranked matched roles
  
  // Certificate name(s) stored directly alongside the plan/roadmap
  certificatesEarned   String?          @map("certificates_earned")
  
  phases               RoadmapPhase[]
  sharedAsTarget       SharedRoadmap[]

  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([sessionId])
  @@index([userId])
  @@index([status])
  @@map("roadmaps")
}

model RoadmapPhase {
  id                   String           @id @default(uuid()) @db.Uuid
  roadmapId            String           @db.Uuid @map("roadmap_id")
  roadmap              Roadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  
  phaseIndex           Int              @map("phase_index") // 1, 2, 3, 4, ...
  phaseTitle           String           @map("phase_title")
  titleLocalized       Json?            @map("title_localized") // { en: string, ms: string, zh: string }
  
  durationWeeks        Int              @default(3) @map("duration_weeks")
  estimatedHours       Int              @default(15) @map("estimated_hours")
  
  badge                String?          @default("")
  badgeType            String?          @default("") @map("badge_type")
  
  description          String?          @map("description")
  descriptionLocalized Json?            @map("description_localized") // { en: string, ms: string, zh: string }
  detail               String?          @map("course_detail")
  
  learningObjectives   String[]         @default([]) @map("learning_objectives")
  objectivesLocalized  Json?            @map("objectives_localized") // { en: string[], ms: string[], zh: string[] }
  recommendedCourses   Json             @default("[]") @map("recommended_courses") // [{title, titleLocalized: {en, ms, zh}, platform, url, isHrdCorpClaimable, isFree, durationHours}]
  
  isCompleted          Boolean          @default(false) @map("is_completed")

  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([roadmapId])
  @@map("roadmap_phases")
}

// ==========================================
// 4. Collaboration & Shared Roadmaps
// ==========================================

model SharedRoadmap {
  id             String     @id @default(uuid()) @db.Uuid
  ownerId        String     @db.Uuid @map("owner_id")
  owner          User       @relation("SharedRoadmapOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetUserId   String     @db.Uuid @map("target_user_id")
  targetUser     User       @relation("SharedRoadmapTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  roadmapId      String?    @db.Uuid @map("roadmap_id")
  roadmap        Roadmap?   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  
  accessLevel    String     @default("viewable") @map("access_level") // "viewable" | "editable"
  title          String?    // Roadmap display title
  isPublic       Boolean    @default(true) @map("is_public")
  synergyData    Json?      @map("synergy_data") // Cross-profile vector delta and complementarity insights
  
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([roadmapId, targetUserId])
  @@index([ownerId])
  @@index([targetUserId])
  @@index([roadmapId])
  @@map("shared_roadmaps")
}