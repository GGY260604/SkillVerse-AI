# RunPod GPU Microservice (BAAI/bge-m3 1024-dim embedding inference)
RUNPOD_API_ENDPOINT=https://your-runpod-pod-id.runpod.net
RUNPOD_API_KEY=your_runpod_api_key

# -----------------------------------------------------------------------------
# Scheduled Tasks & Security
# -----------------------------------------------------------------------------

# Webhook secret used to authenticate Supabase pg_cron / background sync requests.
CRON_SECRET=your_scheduled_cron_webhook_secret

# -----------------------------------------------------------------------------
# Email Dispatching & Multi-Language Auth Delivery
# -----------------------------------------------------------------------------

# Resend API (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="SkillVerse AI <onboarding@resend.dev>"
