# -----------------------------------------------------------------------------
# Email Dispatching & Multi-Language Auth Delivery
# -----------------------------------------------------------------------------

# Resend API (https://resend.com)
RESEND_API_KEY=

# onboarding@resend.dev need to change to your own domain "no-reply@<domain>".
EMAIL_FROM="SkillVerse AI <onboarding@resend.dev>" 

