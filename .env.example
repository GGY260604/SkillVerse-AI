# -----------------------------------------------------------------------------
# SkillVerse AI - Next.js & Fullstack Root Environment Configuration
# Copy this file to `.env` in the repository root.
# NOTE: FastAPI microservice configuration lives in `src/fastapi/.env`
# -----------------------------------------------------------------------------

# Next.js App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# FastAPI Service Endpoints (How Next.js connects to FastAPI)
# -----------------------------------------------------------------------------
# PRIORITY: LOCAL_PYTHON_ENDPOINT -> RUNPOD_API_ENDPOINT -> RENDER_API_ENDPOINT

# Local Python Endpoint (default local dev: http://127.0.0.1:8000)
LOCAL_PYTHON_ENDPOINT=http://127.0.0.1:8000

# RunPod GPU Pod Microservice (BAAI/bge-m3 1024-dim embedding inference)
# Format: https://<POD_ID>-8000.proxy.runpod.net (e.g. https://l4ljrq2b0cwesb-8000.proxy.runpod.net)
RUNPOD_API_ENDPOINT=

# Render-Hosted FastAPI service (Optional Alternative Endpoint)
RENDER_API_ENDPOINT=

# -----------------------------------------------------------------------------
# Supabase Configuration (PostgreSQL 15 + pgvector + Auth)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database Direct Connection (for Prisma / DB migrations)
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# Email Dispatching & Multi-Language Auth Delivery
# -----------------------------------------------------------------------------

# Resend API (https://resend.com)
RESEND_API_KEY=

# onboarding@resend.dev need to change to your own domain "no-reply@<domain>".
EMAIL_FROM="SkillVerse AI <onboarding@resend.dev>" 