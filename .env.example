# -----------------------------------------------------------------------------
# SkillVerse AI - Environment Configuration Example
# Copy this file to `.env` (or `.env.local`) and populate with your real credentials.
# -----------------------------------------------------------------------------

# Next.js App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Configuration (PostgreSQL 15 + pgvector + Auth)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Database Direct Connection (for Prisma / DB migrations)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# AI & LLM Inference Engines
# -----------------------------------------------------------------------------

